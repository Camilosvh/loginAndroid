<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SmileCare" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorError">@color/state_error</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SmileCare" parent="Base.Theme.SmileCare" />

    <!-- Estilo del campo de texto con colores por estado -->
    <style name="Widget.SmileCare.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/stroke_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeErrorColor">@color/state_error</item>
        <item name="errorTextColor">@color/state_error</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>